# Django local
SECRET_KEY="GENERA_UNA_CLAVE_NUEVA"
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Copia una URI completa desde Supabase > Connect.
# Session pooler (5432) es la opción recomendada para Render.
DATABASE_URL="postgresql://postgres.PROJECT_REF:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY="sb_secret_TU_CLAVE_SOLO_BACKEND"
# Supabase > Project Settings > API Keys > Publishable/anon key.
# Se usa desde el servidor para iniciar sesión con las cuentas de la app.
SUPABASE_ANON_KEY="sb_publishable_TU_CLAVE_PUBLICA"
SUPABASE_PUBLIC_BUCKET=movix-public
SUPABASE_PRIVATE_BUCKET=movix-documents

# Opcional: JSON completo o ruta absoluta de la cuenta de servicio Firebase.
FIREBASE_CREDENTIALS_JSON=
MAX_UPLOAD_MB=10

# Correo saliente para facturas, reuniones y avisos. Para Gmail usa una
# contraseña de aplicación, nunca la contraseña normal de la cuenta.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=movix_soporte@gmail.com
EMAIL_HOST_PASSWORD="TU_CONTRASENA_DE_APLICACION_GMAIL"
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL="MOVIX <movix_soporte@gmail.com>"

# Datos públicos de contacto de la landing
MOVIX_SUPPORT_EMAIL=movix_soporte@gmail.com
MOVIX_WHATSAPP_NUMBER=593989414258
MOVIX_WHATSAPP_DISPLAY="098 941 4258"
MOVIX_FACEBOOK_URL=https://www.facebook.com/TU_PAGINA_MOVIX
